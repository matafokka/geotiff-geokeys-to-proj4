{
  "type": "module",
  "name": "geotiff-geokeys-to-proj4",
  "version": "2026.08.13",
  "description": "A library that converts GeoTIFF's geokeys to Proj4 string",
  "license": "BSD-3-Clause",
  "author": "matafokka",
  "homepage": "https://matafokka.github.io/geotiff-geokeys-to-proj4/",
  "repository": "https://github.com/matafokka/geotiff-geokeys-to-proj4",
  "keywords": [
    "geotiff",
    "geokeys",
    "geo-keys",
    "proj",
    "proj4",
    "proj4js",
    "geotiff-keys",
    "geotiff-geokeys",
    "geotiff-geo-keys"
  ],

  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "require": {
        "default": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      },
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "module": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },

  "scripts": {
    "dev": "npm run gen:docs && vitepress dev docs",
    "preview": "npm run gen:docs && vitepress preview docs",
    "type-check": "tsc --noEmit",
    "test": "tsx tests/test.ts",

    "build": "run-s build:lib build:docs",
    "build:lib": "vite build",
    "build:docs": "npm run gen:docs && vitepress build docs",

    "gen:lib:db": "npm run gen:lib -- --mode db",
    "gen:lib:code": "npm run gen:lib -- --mode code",
    "gen:lib": "tsx src/cli/update",

    "gen:docs": "run-p gen:docs:api gen:docs:homepage",
    "gen:docs:api": "typedoc",
    "gen:docs:homepage": "tsx docs/scripts/generate-home-page"
  },

  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "npm-run-all2": "^9.0.3",
    "pg": "8.22.0",
    "prettier": "^3.9.6",
    "terser": "^5.49.2",
    "tsx": "^4.23.11",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.1",
    "vitepress": "^1.6.4"
  }
}
